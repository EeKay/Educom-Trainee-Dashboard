    {
      "parameters": {
        "jsCode": "const items = $input.all();\nif (items.length === 0) {\n  return [{ json: { status: 'not_found' } }];\n}\n\nconst row = items[0].json;\nconst now = new Date();\nconst isUsed = row.used_at !== null;\nconst isExpired = new Date(row.expires_at) <= now;\n\nlet status = 'valid';\nif (isUsed) status = 'used';\nelse if (isExpired) status = 'expired';\n\nreturn [{ json: { ...row, status } }];"
      },
