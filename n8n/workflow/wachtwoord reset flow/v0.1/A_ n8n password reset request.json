        "jsonBody": "={\n  \"to\": \"{{ $json.email }}\",\n  \"subject\": \"Bevestig je wachtwoord reset\",\n  \"text\": \"Klik op de volgende link om je n8n-wachtwoord te resetten: {{ $json.confirmUrl }}\\n\\nDeze link is 30 minuten geldig en kan maar één keer gebruikt worden.\",\n  \"html\": \"<p>Klik op de volgende link om je n8n-wachtwoord te resetten:</p><p><a href=\\\"{{ $json.confirmUrl }}\\\">{{ $json.confirmUrl }}</a></p><p>Deze link is 30 minuten geldig en kan maar één keer gebruikt worden.</p>\",\n  \"labels\": [\"password-reset\"]\n}",
