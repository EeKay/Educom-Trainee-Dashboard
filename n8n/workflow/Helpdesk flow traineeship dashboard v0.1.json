      "parameters": {
        "operation": "executeQuery",
        "query": "WITH matched_faq AS (\n    -- Attempt to find the best valid match\n    SELECT id, question, answer,\n           (\n             ts_rank_cd(\n               question_vector, \n               to_tsquery('dutch', array_to_string(tsvector_to_array(to_tsvector('dutch', $1)), ' | '))\n             ) \n             + \n             similarity(question, $1)\n           ) / 2 AS confidence\n    FROM faq\n    WHERE is_active = true\n      AND (\n        question_vector @@ to_tsquery('dutch', array_to_string(tsvector_to_array(to_tsvector('dutch', $1)), ' | '))\n        OR \n        similarity(question, $1) > 0.3\n      )\n    ORDER BY confidence DESC\n    LIMIT 1\n)\n-- 1. Return the match if it exists\nSELECT id, question, answer, confidence \nFROM matched_faq\n\nUNION ALL\n\n-- 2. If it does NOT exist, return this dummy row with 0 confidence\nSELECT NULL as id, NULL as question, NULL as answer, 0 as confidence\nWHERE NOT EXISTS (SELECT 1 FROM matched_faq);",
        "options": {
          "queryReplacement": "={{ $json.question }}"
        }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
