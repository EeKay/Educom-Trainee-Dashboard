    {
      "parameters": {
        "jsCode": "let raw = $input.item.json.output; // swap in whatever field name you actually see\nraw = raw.trim().replace(/^```json\\s*/i, '').replace(/```$/, '');\n\ntry {\n  let parsed = JSON.parse(raw);\n  if (parsed.output) parsed = parsed.output;\n  return { json: parsed };\n} catch (e) {\n  return { json: { answer: \"Something went wrong\", resolved: false, reason: \"parse_error\" } };\n}"
      },
